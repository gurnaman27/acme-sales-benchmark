{
  manifest_version: "0.1.0",
  experimental_features: ["docker"],
  config_schema: {
    type: "object",
    properties: {
      openai_api_key: { type: "string", secret: true },
      deepseek_api_key: { type: "string", secret: true }
    },
    required: [],
    additionalProperties: false
  },
  slots: {},
  program: {
    image: "ghcr.io/gurnaman27/acme-sales-benchmark:latest",
    entrypoint: "uvicorn acme.green_agent.a2a_server:app --host 0.0.0.0 --port 9009",
    env: {
      PYTHONUNBUFFERED: "1"
    },
    network: {
      endpoints: [
        { name: "a2a_endpoint", port: 9009 }
      ]
    }
  },
  provides: {
    a2a: {
      kind: "a2a",
      endpoint: "a2a_endpoint"
    }
  },
  exports: {
    a2a: "a2a"
  },
  metadata: {
    assessment_config: {
      num_tasks: 30,
      seed: 42
    },
    participant_roles: ["agent"]
  }
}
